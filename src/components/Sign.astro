---
// Original SVG renderings of standard US road signs (MUTCD device designs are
// public domain; all artwork here is drawn fresh for permitdrills.com — never
// extracted from any handbook). Keyed by the `sign` field in question banks.
const { id, size = 120 } = Astro.props;
const s = size;
const signs: Record<string, string> = {
  stop: `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Stop sign"><polygon points="30,4 70,4 96,30 96,70 70,96 30,96 4,70 4,30" fill="#BF0D3E" stroke="#fff" stroke-width="3"/><polygon points="31,9 69,9 91,31 91,69 69,91 31,91 9,69 9,31" fill="none" stroke="#fff" stroke-width="2"/><text x="50" y="62" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#fff" text-anchor="middle">STOP</text></svg>`,
  yield: `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Yield sign"><polygon points="50,94 6,14 94,14" fill="#BF0D3E" stroke="#888" stroke-width="2"/><polygon points="50,82 18,22 82,22" fill="#fff"/><text x="50" y="42" font-family="Arial,Helvetica,sans-serif" font-size="13" font-weight="700" fill="#BF0D3E" text-anchor="middle">YIELD</text></svg>`,
  'do-not-enter': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Do not enter sign"><rect x="6" y="6" width="88" height="88" rx="8" fill="#BF0D3E"/><rect x="18" y="40" width="64" height="16" rx="3" fill="#fff"/><text x="50" y="30" font-family="Arial,Helvetica,sans-serif" font-size="12.5" font-weight="700" fill="#fff" text-anchor="middle">DO NOT</text><text x="50" y="76" font-family="Arial,Helvetica,sans-serif" font-size="12.5" font-weight="700" fill="#fff" text-anchor="middle">ENTER</text></svg>`,
  'wrong-way': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Wrong way sign"><rect x="4" y="24" width="92" height="52" rx="6" fill="#BF0D3E"/><text x="50" y="47" font-family="Arial,Helvetica,sans-serif" font-size="15" font-weight="700" fill="#fff" text-anchor="middle">WRONG</text><text x="50" y="67" font-family="Arial,Helvetica,sans-serif" font-size="15" font-weight="700" fill="#fff" text-anchor="middle">WAY</text></svg>`,
  'one-way': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="One way sign"><rect x="4" y="26" width="92" height="48" rx="6" fill="#fff" stroke="#111" stroke-width="3"/><path d="M14 50 H70 M58 36 L74 50 L58 64" fill="none" stroke="#111" stroke-width="6"/><text x="50" y="20" font-family="Arial,Helvetica,sans-serif" font-size="11" font-weight="700" fill="#111" text-anchor="middle">ONE WAY</text></svg>`,
  'speed-limit': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Speed limit sign"><rect x="18" y="6" width="64" height="88" rx="6" fill="#fff" stroke="#111" stroke-width="3"/><text x="50" y="28" font-family="Arial,Helvetica,sans-serif" font-size="13" font-weight="700" fill="#111" text-anchor="middle">SPEED</text><text x="50" y="44" font-family="Arial,Helvetica,sans-serif" font-size="13" font-weight="700" fill="#111" text-anchor="middle">LIMIT</text><text x="50" y="80" font-family="Arial,Helvetica,sans-serif" font-size="34" font-weight="700" fill="#111" text-anchor="middle">35</text></svg>`,
  'no-left-turn': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="No left turn sign"><rect x="8" y="8" width="84" height="84" rx="8" fill="#fff" stroke="#111" stroke-width="2"/><path d="M62 74 V44 Q62 30 48 30 H34" fill="none" stroke="#111" stroke-width="7"/><path d="M22 30 L36 20 V40 Z" fill="#111"/><circle cx="50" cy="50" r="40" fill="none" stroke="#BF0D3E" stroke-width="7"/><path d="M20 78 L80 24" stroke="#BF0D3E" stroke-width="7"/></svg>`,
  'no-u-turn': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="No U-turn sign"><rect x="8" y="8" width="84" height="84" rx="8" fill="#fff" stroke="#111" stroke-width="2"/><path d="M38 76 V42 Q38 28 50 28 Q62 28 62 42 V52" fill="none" stroke="#111" stroke-width="7"/><path d="M62 66 L52 50 H72 Z" fill="#111"/><circle cx="50" cy="50" r="40" fill="none" stroke="#BF0D3E" stroke-width="7"/><path d="M20 78 L80 24" stroke="#BF0D3E" stroke-width="7"/></svg>`,
