  'pedestrian-crossing': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Pedestrian crossing sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><g fill="#111"><circle cx="44" cy="30" r="5"/><path d="M44 36 L40 52 L32 66 M40 52 L50 58 L52 72 M44 40 L34 48 M44 40 L56 46" stroke="#111" stroke-width="4" fill="none"/></g><path d="M62 74 h22 M68 74 v10 M76 74 v10" stroke="#111" stroke-width="3"/></svg>`,
  'school-crossing': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="School crossing sign"><polygon points="50,4 94,30 94,72 6,72 6,30" fill="#A6CE39" stroke="#111" stroke-width="3"/><g stroke="#111" stroke-width="3.4" fill="none"><circle cx="40" cy="34" r="4" fill="#111"/><path d="M40 39 L37 52 L31 62 M37 52 L46 55 L48 65 M40 43 L32 48 M40 43 L49 47"/><circle cx="60" cy="36" r="3.4" fill="#111"/><path d="M60 40 L63 51 L68 59 M63 51 L55 54 L54 63 M60 44 L67 48"/></g></svg>`,
  'railroad-crossing': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Railroad crossing sign"><g stroke="#111" stroke-width="2" fill="#fff"><rect x="8" y="18" width="84" height="15" rx="4" transform="rotate(24 50 50)"/><rect x="8" y="67" width="84" height="15" rx="4" transform="rotate(-24 50 50)"/></g><text x="50" y="29" font-family="Arial,Helvetica,sans-serif" font-size="10.5" font-weight="700" fill="#111" text-anchor="middle" transform="rotate(24 50 50)">RAILROAD</text><text x="50" y="80" font-family="Arial,Helvetica,sans-serif" font-size="10.5" font-weight="700" fill="#111" text-anchor="middle" transform="rotate(-24 50 50)">CROSSING</text></svg>`,
  'railroad-ahead': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Railroad crossing ahead sign"><circle cx="50" cy="50" r="45" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M28 34 L72 66 M72 34 L28 66" stroke="#111" stroke-width="6"/><text x="50" y="26" font-family="Arial,Helvetica,sans-serif" font-size="13" font-weight="700" fill="#111" text-anchor="middle">R</text><text x="50" y="82" font-family="Arial,Helvetica,sans-serif" font-size="13" font-weight="700" fill="#111" text-anchor="middle">R</text></svg>`,
  'curve-ahead': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Curve ahead sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M38 76 Q38 40 62 32" fill="none" stroke="#111" stroke-width="6"/><path d="M52 24 L68 28 L60 42 Z" fill="#111"/></svg>`,
  'sharp-turn': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Sharp turn sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M34 74 V46 Q34 34 46 34 H62" fill="none" stroke="#111" stroke-width="6"/><path d="M54 24 L70 34 L54 44 Z" fill="#111"/></svg>`,
  'slippery': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Slippery when wet sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><g stroke="#111" stroke-width="3.4" fill="none"><path d="M26 56 q6 -10 14 -4 q8 5 14 -2 q7 -7 16 -2"/><rect x="30" y="34" width="34" height="12" rx="4" fill="#111" stroke="none"/><circle cx="38" cy="50" r="4" fill="#111" stroke="none"/><circle cx="58" cy="50" r="4" fill="#111" stroke="none"/></g></svg>`,
  merge: `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Merge sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M38 76 V44 M62 76 V52 Q62 40 50 38" fill="none" stroke="#111" stroke-width="6"/><path d="M50 26 L58 40 H42 Z" fill="#111"/></svg>`,
  'two-way-traffic': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Two-way traffic sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M40 74 V34 M32 44 L40 30 L48 44" fill="none" stroke="#111" stroke-width="5"/><path d="M62 26 V66 M54 56 L62 70 L70 56" fill="none" stroke="#111" stroke-width="5"/></svg>`,
  'divided-highway': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Divided highway sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M34 76 V44 Q34 30 50 30 Q66 30 66 44 V76" fill="none" stroke="#111" stroke-width="5"/><rect x="45" y="42" width="10" height="34" fill="#111"/></svg>`,
  'signal-ahead': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Traffic signal ahead sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><rect x="41" y="20" width="18" height="48" rx="6" fill="#111"/><circle cx="50" cy="30" r="5.5" fill="#BF0D3E"/><circle cx="50" cy="44" r="5.5" fill="#F7C500" stroke="#333"/><circle cx="50" cy="58" r="5.5" fill="#2E9E4F"/></svg>`,
  'stop-ahead': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Stop ahead sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><polygon points="42,24 58,24 66,32 66,44 58,52 42,52 34,44 34,32" fill="#BF0D3E"/><path d="M50 62 v16 M42 70 l8 8 8 -8" fill="none" stroke="#111" stroke-width="4"/></svg>`,
  'deer-crossing': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Deer crossing sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M34 62 L40 44 L52 38 L60 30 M52 38 L66 42 L64 52 M40 44 L34 40 M60 30 L58 22 M60 30 L66 24 M44 54 L40 70 M56 52 L60 70" stroke="#111" stroke-width="3.6" fill="none"/></svg>`,
  construction: `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Road work ahead sign"><polygon points="50,4 96,50 50,96 4,50" fill="#E87722" stroke="#111" stroke-width="3"/><g stroke="#111" stroke-width="3.4" fill="none"><circle cx="44" cy="32" r="4" fill="#111"/><path d="M44 37 L42 50 L34 60 M42 50 L52 52 M44 41 L54 44 L60 38"/><path d="M28 66 h30 l-4 -8 h-22 Z" fill="#111" stroke="none"/></g></svg>`,
  'bicycle': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Bicycle sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><g stroke="#111" stroke-width="3.2" fill="none"><circle cx="36" cy="62" r="9"/><circle cx="64" cy="62" r="9"/><path d="M36 62 L48 44 H60 M48 44 L64 62 M56 40 h6"/></g></svg>`,
  'lane-ends': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Lane ends sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M38 76 V24 M62 76 V52 Q62 38 52 34" fill="none" stroke="#111" stroke-width="6"/></svg>`,
  'roundabout-ahead': `<svg viewBox="0 0 100 100" width="${s}" height="${s}" role="img" aria-label="Roundabout ahead sign"><polygon points="50,4 96,50 50,96 4,50" fill="#F7C500" stroke="#111" stroke-width="3"/><path d="M64 36 A18 18 0 1 0 66 58" fill="none" stroke="#111" stroke-width="5"/><path d="M58 28 L70 32 L62 42 Z" fill="#111"/><path d="M40 62 A18 18 0 0 0 52 70" fill="none" stroke="#111" stroke-width="5"/><path d="M44 76 L34 68 L46 62 Z" fill="#111"/></svg>`,
};
const html = signs[id] || '';
---
<Fragment set:html={html} />
