---
import Base from '../../layouts/Base.astro';
import SignBank from '../../components/SignBank.astro';
import { STATES, TOPICS, getBank } from '../../lib/site';

export function getStaticPaths() {
  return Object.keys(STATES).map((slug) => ({ params: { state: slug } }));
}
const { state } = Astro.params;
const meta = STATES[state];
const bank = getBank(state);
const payload = { mode: 'exam', slug: state, exam: bank?.exam, topics: TOPICS, questions: bank?.questions ?? [] };
---
<Base title={`${meta.nameZh}驾照笔试模拟考试 ${meta.nameEn} Exam Simulator`} description={`${meta.nameZh}驾照笔试模拟考试：按官方题量、及格线与限时，交卷出成绩报告。`}>
  <p class="small muted"><a href={`/${state}/`}>← {meta.nameZh} {meta.nameEn}</a> · 模拟考试 Exam simulator</p>
  <h1 style="font-size:30px">{meta.nameZh}模拟考试</h1>
  <div id="quiz-root"></div>
  <SignBank />
  <script type="application/json" id="pd-bank" set:html={JSON.stringify(payload)}></script>
  <script src="/quiz.js" defer></script>
</Base>
