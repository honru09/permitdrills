---
import Base from '../../layouts/Base.astro';
import { STATES, TOPICS, getBank, topicCounts } from '../../lib/site';

export function getStaticPaths() {
  return Object.keys(STATES).map((slug) => ({ params: { state: slug } }));
}
const { state } = Astro.params;
const meta = STATES[state];
const bank = getBank(state);
const counts = bank ? topicCounts(bank) : {};
const ex = bank?.exam;
const passText = ex
  ? ex.passCorrect != null
    ? `答对 ${ex.passCorrect} 题（共 ${ex.questions} 题）及格`
    : ex.passPercent != null
      ? `正确率达到 ${ex.passPercent}% 及格（共 ${ex.questions} 题）`
      : `共 ${ex.questions} 题`
  : '';
---
<Base
  title={`${meta.nameZh}驾照笔试中文练习 ${meta.nameEn} Permit Practice Test`}
  description={`${meta.nameZh}（${meta.nameEn}）驾照笔试中文练习题：根据《${ex?.handbook.title ?? ''}》编写的原创题，中英双语，逐题标注出处，含按官方格式的模拟考试。`}
>
  <p><span class="chip">{meta.agency}</span> <span class="chip gray">官方考试提供中文版 · 本站中文讲解</span></p>
  <h1>{meta.nameZh}驾照笔试练习<br /><span style="font-size:.62em;color:var(--muted)">{meta.nameEn} Permit Practice Test</span></h1>
  <p class="lede">
    根据《{ex?.handbook.title}》（{ex?.handbook.edition}）编写的 {bank?.questions.length} 道原创练习题。
    题面、选项、讲解都有简体中文和英文两个版本，随时切换。数据截至 {ex?.currentAsOf}。
  </p>

  <div class="card">
    <h3 style="margin-top:0">{meta.nameZh}官方笔试格式 · Official format</h3>
    <div class="facts">
      <span class="chip">{passText}</span>
      {ex?.timeMinutes ? <span class="chip">限时 {ex.timeMinutes} 分钟</span> : <span class="chip gray">官方未公布统一限时</span>}
      <span class="chip gray">官方考试语言含中文</span>
    </div>
    <p class="small muted" style="margin-bottom:0">
      依据手册：<a href={ex?.handbook.url} target="_blank" rel="noopener">{ex?.handbook.title}（{ex?.handbook.edition}）</a>
      {ex?.handbook.chineseUrl && <> · <a href={ex.handbook.chineseUrl} target="_blank" rel="noopener">官方中文版手册</a></>}
      <br />本站题目为原创练习题，与官方考试题目不同；正式考试内容以官方手册与州法律为准。
    </p>
  </div>

  <h2>开始练习 · Start</h2>
  <div class="grid c2">
    <a class="card statecard" href={`/${state}/practice/`}>
      <h3>分专题练习</h3>
      <p class="muted" style="margin:0">点完立刻看对错、讲解和手册出处。可以按专题练，进度保存在本机。</p>
      <p style="margin-bottom:0"><span class="btn amber" style="pointer-events:none">开始练习</span></p>
    </a>
    <a class="card statecard" href={`/${state}/exam/`}>
      <h3>模拟考试</h3>
      <p class="muted" style="margin:0">{passText}{ex?.timeMinutes ? `，限时 ${ex.timeMinutes} 分钟` : ''}。交卷后出成绩报告和分专题分析。</p>
      <p style="margin-bottom:0"><span class="btn" style="pointer-events:none">开始模考</span></p>
    </a>
  </div>

  <h2>按专题学 · Study by topic</h2>
  <div class="grid c3">
    {Object.entries(TOPICS).map(([id, t]) => (
      <a class="card statecard" href={`/${state}/topics/${id}/`}>
        <h3 style="font-size:18px">{t.icon} {t.zh}</h3>
        <p class="muted small" style="margin:0">{t.en} · {counts[id] ?? 0} 道题（含答案与讲解的学习页）</p>
      </a>
    ))}
  </div>
</Base>
